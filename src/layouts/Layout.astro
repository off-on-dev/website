---
import { ClientRouter } from "astro:transitions";
import SEO from "@/components/SEO.astro";
import Navbar from "@/components/Navbar.astro";
import Footer from "@/components/Footer.astro";
import ConsentBanner from "@/components/ConsentBanner.astro";
import { BRAND_NAME, SITE_NAME, SITE_URL, COMMUNITY_URL, LINKEDIN_URL, X_URL, BLUESKY_URL, BRAND_SHORT_DESCRIPTION } from "@/lib/site";
import "@/styles/index.css";

// App shell. Per-page SEO is delegated to <SEO>.
interface Props {
  title: string;
  description: string;
  /** Canonical path for this page, e.g. "/adventures/". Defaults to the current URL. */
  path?: string;
  ogType?: string;
  /** Keep this page out of the search index (e.g. legal pages). */
  noindex?: boolean;
}
const { title, description, path, ogType, noindex } = Astro.props;
const canonicalPath = path ?? Astro.url.pathname;

const base = import.meta.env.BASE_URL;
// PR-preview deployments (BASE_URL=/pr-preview/pr-N/) must not be indexed.
// Narrow check so it never fires in production (BASE_URL="/").
const isPreview = base.startsWith("/pr-preview/");

// Inline scripts that must execute before any CSS/JS loads — do not paraphrase.
const themeScript = `(function(){try{var t=localStorage.getItem("theme");if(t==="light"){document.documentElement.classList.remove("dark");document.documentElement.classList.add("light");}}catch(e){}})();`;

const gtagBootstrap = `window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('consent','default',{analytics_storage:'denied',ad_storage:'denied',ad_user_data:'denied',ad_personalization:'denied'});`;

// With <ClientRouter />, re-assert the theme class after each swap, before paint,
// so the theme does not flash on client navigation (research-confirmed gotcha).
// Also move focus to #main-content after each swap: Astro's router restores prior
// focus but does not move focus into the landmark; do that for keyboard/AT users.
// (Fires only on client navigation, not the initial load.)
const themeAfterSwap = `document.addEventListener("astro:after-swap",function(){try{var t=localStorage.getItem("theme");var c=document.documentElement.classList;if(t==="light"){c.remove("dark");c.add("light");}else{c.remove("light");c.add("dark");}}catch(e){}var m=document.getElementById("main-content");if(m){m.focus({preventScroll:true});}});`;

const webSiteJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: BRAND_NAME,
  url: SITE_URL,
  description: BRAND_SHORT_DESCRIPTION,
});

const orgJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Organization",
  name: BRAND_NAME,
  url: SITE_URL,
  logo: `${SITE_URL}/brand/offon-logo-dark-color.png`,
  sameAs: [LINKEDIN_URL, COMMUNITY_URL, "https://github.com/off-on-dev/open-source-challenges", X_URL, BLUESKY_URL],
});

const fontPreloads = [
  "fonts/inter-latin-400-normal.woff2",
  "fonts/inter-latin-500-normal.woff2",
  "fonts/inter-latin-600-normal.woff2",
  "fonts/inter-latin-700-normal.woff2",
  "fonts/syne-latin-700-normal.woff2",
];
---

<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="author" content={SITE_NAME} />

    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="icon" href={`${base}favicon.png`} type="image/png" />
    <link rel="shortcut icon" href={`${base}favicon.ico`} />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}site.webmanifest`} />

    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f5f5ff" media="(prefers-color-scheme: light)" />

    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://community.offon.dev https://*.discourse-cdn.com; font-src 'self'; connect-src 'self' https://www.google-analytics.com https://region1.google-analytics.com; base-uri 'self'; form-action 'self'; object-src 'none';"
    />
    <meta name="referrer" content="strict-origin-when-cross-origin" />

    {isPreview && <meta name="robots" content="noindex" />}

    <link rel="sitemap" type="application/xml" href={`${base}sitemap.xml`} />
    <link rel="api-catalog" href={`${base}.well-known/api-catalog`} />

    {fontPreloads.map((f) => (
      <link rel="preload" href={`${base}${f}`} as="font" type="font/woff2" crossorigin="anonymous" />
    ))}

    {/* Theme set before paint to prevent flash of wrong theme */}
    <script is:inline set:html={themeScript} />
    <script is:inline set:html={themeAfterSwap} />
    {/* Consent Mode v2 default-denied bootstrap. gtag.js loads later, only on Accept (Phase 4). */}
    <script is:inline set:html={gtagBootstrap} />

    <script type="application/ld+json" is:inline set:html={webSiteJsonLd} />
    <script type="application/ld+json" is:inline set:html={orgJsonLd} />

    <SEO title={title} description={description} path={canonicalPath} ogType={ogType} noindex={noindex} />

    {/* Per-page <head> additions, e.g. <StructuredData> on adventure/level/solution pages. */}
    <slot name="head" />

    <ClientRouter />
  </head>
  <body>
    <a href="#main-content" class="skip-nav">Skip to main content</a>
    <span id="theme-status" role="status" class="sr-only" aria-live="polite" aria-atomic="true"></span>
    {/* Shared "opens in a new tab" description referenced via aria-describedby on external links. */}
    <span id="new-tab-hint" hidden>opens in a new tab</span>
    <Navbar />
    <slot />
    <Footer />
    <ConsentBanner />

    {/* Site-wide script bundle. Analytics lifecycle + all interactive progressive
        enhancements (theme toggle, mobile menu, starter nudge, code-block copy,
        abbr tooltips). Consolidated into one block so Rollup's shared-dependency
        graph externalises the entire bundle — preventing inline <script type="module">
        tags that trigger Astro's sentinel data: URI on client navigation. */}
    <script>
      import { firePageView, trackClicks } from "@/stores/consent";
      import "@/scripts/theme-toggle";
      import "@/scripts/mobile-menu";
      import "@/scripts/starter-nudge";
      import "@/scripts/copy-buttons";
      import "@/scripts/abbr-tooltips";
      import "@/scripts/brand-toc";
      import "@/scripts/solution-hash";

      // astro:page-load fires on the initial load and after every client-side
      // navigation. For returning visitors (stored consent) this covers the first
      // page_view of a session. New visitors who accept consent on the landing
      // page get their first page_view from grant() → firePageView() in
      // consent.ts, because astro:page-load does not re-fire on a banner click.
      document.addEventListener("astro:page-load", firePageView);
      trackClicks();
    </script>
  </body>
</html>
