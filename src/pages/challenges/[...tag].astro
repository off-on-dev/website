---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import AdventureCard from "@/components/AdventureCard.astro";
import PageHero from "@/components/PageHero.astro";
import ChallengeBuildersSection from "@/components/ChallengeBuildersSection.astro";
import CommunityLeaders from "@/components/CommunityLeaders.astro";
import BottomCTA from "@/components/BottomCTA.astro";
import StarterNudge from "@/components/StarterNudge.vue";
import ChallengesFilter from "@/components/ChallengesFilter.vue";
import { BRAND_NAME } from "@/lib/site";
import { getChallengeData, tagToSlug, isAdventureLive, sortAdventuresByMonthDesc } from "@/lib/challenges";

export async function getStaticPaths() {
  const adventures = (await getCollection("adventures")).map((a) => a.data);
  const { tags } = getChallengeData(adventures);
  return [
    { params: { tag: undefined }, props: { initialTag: null } },
    ...tags.map((tag) => ({ params: { tag: tagToSlug(tag) }, props: { initialTag: tag } })),
  ];
}

const { initialTag } = Astro.props;
const base = import.meta.env.BASE_URL;

const adventures = sortAdventuresByMonthDesc((await getCollection("adventures")).map((a) => a.data));
const { entries, tags } = getChallengeData(adventures);
const adventureCount = adventures.length;

// Starter nudge target: first live adventure and its beginner level.
const starter = adventures.find((a) => isAdventureLive(a));
const starterLevel = starter?.levels.find((l) => l.difficulty === "Beginner");

const title = initialTag ? `${initialTag} Challenges - ${BRAND_NAME}` : `Challenges - ${BRAND_NAME}`;
const description = initialTag
  ? `Hands-on open source challenges using ${initialTag}. Practice in real-world scenarios in GitHub Codespaces.`
  : "Browse hands-on open source challenges. Filter by technology and difficulty, then solve them in GitHub Codespaces.";
const path = initialTag ? `/challenges/${tagToSlug(initialTag)}/` : "/challenges/";
---

<Layout title={title} description={description} path={path}>
  <main id="main-content" tabindex="-1">
    <PageHero
      eyebrow="Challenges"
      title="Open Source Challenges"
      description="Each adventure focuses on one open source technology, with challenges at different difficulty levels. Pick your adventure, work through real-world scenarios hands-on, and share what you learn with the community."
    />

    <section class="py-24 px-6 md:px-16">
      <div class="mx-auto max-w-6xl">
        {starter && starterLevel && (
          <StarterNudge
            client:idle
            adventureId={starter.slug}
            adventureTitle={starter.title}
            tag={starter.tags[0]}
            levelId={starterLevel.id}
            base={base}
          />
        )}

        <ChallengesFilter
          entries={entries}
          tags={tags}
          base={base}
          initialTag={initialTag}
          adventureCount={adventureCount}
          client:idle
        >
          {adventures.map((a) => (
            <AdventureCard slot="adventures" adventure={{ ...a, isLive: isAdventureLive(a) }} />
          ))}
        </ChallengesFilter>
      </div>
    </section>

    <ChallengeBuildersSection>
      <CommunityLeaders
        slot="aside"
        sections={["top-challenge-solvers", "challenge-rockstars", "challenge-grand-builders", "challenge-builders"]}
      />
    </ChallengeBuildersSection>

    <BottomCTA />
  </main>
</Layout>
