---
import { getCollection } from "astro:content";
import IconExternalLink from '~icons/lucide/external-link';
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/Hero.astro";
import AdventureCard from "@/components/AdventureCard.astro";
import SectionLabel from "@/components/SectionLabel.astro";
import ChallengeHighlights from "@/components/ChallengeHighlights.astro";
import CommunitySection from "@/components/CommunitySection.astro";
import CommunityLeaders from "@/components/CommunityLeaders.astro";
import SponsorStrip from "@/components/SponsorStrip.astro";
import BottomCTA from "@/components/BottomCTA.astro";
import StarterNudge from "@/components/StarterNudge.vue";
import ChallengesFilter from "@/components/ChallengesFilter.vue";
import { getChallengeData, isAdventureLive, sortAdventuresByMonthDesc } from "@/lib/challenges";
import { BRAND_NAME, BRAND_SHORT_DESCRIPTION, BRAND_SLOGAN, PROPOSE_ADVENTURE_URL } from "@/lib/site";

const base = import.meta.env.BASE_URL;
const HOME_ADVENTURE_LIMIT = 6;
const COMMUNITY_LEADERS_PREVIEW_LIMIT = 3;

const adventures = sortAdventuresByMonthDesc((await getCollection("adventures")).map((a) => a.data));

const visibleAdventures = adventures.slice(0, HOME_ADVENTURE_LIMIT);
const hasMore = adventures.length > HOME_ADVENTURE_LIMIT;

const { entries, tags } = getChallengeData(adventures);
// Starter nudge target: first live adventure and its beginner level.
const starter = adventures.find((a) => isAdventureLive(a));
const starterLevel = starter?.levels.find((l) => l.difficulty === "Beginner");
---

<Layout title={`${BRAND_NAME} - ${BRAND_SLOGAN}`} description={BRAND_SHORT_DESCRIPTION} path="/">
  <main id="main-content" tabindex="-1">
    <Hero />

    <section id="challenges" aria-labelledby="challenges-heading" class="py-24 px-6 md:px-16">
      <div class="mx-auto max-w-6xl">
        <SectionLabel>Adventures</SectionLabel>
        <h2 id="challenges-heading" class="mb-6 text-3xl font-bold text-primary md:text-4xl">
          Choose Your Adventure
        </h2>
        {starter && starterLevel && (
          <StarterNudge
            client:idle
            adventureId={starter.slug}
            adventureTitle={starter.title}
            tag={starter.tags[0] ?? ""}
            levelId={starterLevel.id}
            base={base}
          />
        )}
        <ChallengesFilter
          entries={entries}
          tags={tags}
          base={base}
          initialTag={null}
          adventureCount={visibleAdventures.length}
          embedded
          seeAllHref={hasMore ? `${base}challenges/` : undefined}
          client:visible
        >
          {visibleAdventures.map((a) => (
            <AdventureCard slot="adventures" adventure={{ ...a, isLive: isAdventureLive(a) }} />
          ))}
        </ChallengesFilter>
      </div>
    </section>

    <ChallengeHighlights />

    <section aria-labelledby="adventure-idea-heading" class="bg-primary py-16 px-6 md:px-16">
      <div class="mx-auto max-w-6xl grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
        <h2 id="adventure-idea-heading" class="text-4xl md:text-5xl font-bold leading-tight tracking-tight text-primary-foreground">
          <span class="block">Got an Idea</span>
          <span class="block">for an Adventure?</span>
        </h2>
        <div class="flex flex-col gap-4">
          <p class="font-sans text-base leading-relaxed text-background/90">
            An adventure is a set of hands-on challenges built around one open source technology. Submit a scenario and help shape what the community learns next.
          </p>
          <div class="flex gap-3 flex-wrap mt-2">
            <a href={PROPOSE_ADVENTURE_URL} target="_blank" rel="noopener noreferrer" aria-describedby="new-tab-hint" class="btn-inverse">
              Propose an Adventure Idea <IconExternalLink width={14} height={14} aria-hidden="true" />
            </a>
          </div>
        </div>
      </div>
    </section>

    <CommunitySection>
      <CommunityLeaders
        slot="aside"
        sections={["top-contributors", "challenge-rockstars", "challenge-grand-builders", "top-challenge-solvers", "challenge-builders", "most-supportive"]}
        limit={COMMUNITY_LEADERS_PREVIEW_LIMIT}
      />
    </CommunitySection>

    <SponsorStrip />
    <BottomCTA />
  </main>
</Layout>
