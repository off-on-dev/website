---
import Layout from "@/layouts/Layout.astro";
import SectionLabel from "@/components/SectionLabel.astro";
import { BRAND_NAME } from "@/lib/site";

// GitHub Pages serves this as 404.html for unmatched paths, returning a real
// HTTP 404 (no soft-404 / catch-all route needed). noindex so the fixed /404/
// canonical is moot for SEO.
const base = import.meta.env.BASE_URL;

const links = [
  { label: "Handbook", desc: "Your guide to getting started, posting, and growing in the community.", href: `${base}handbook/` },
  { label: "Challenges", desc: "Browse hands-on challenges with real-world scenarios.", href: `${base}challenges/` },
  { label: "About", desc: `Learn what ${BRAND_NAME} is and who it's for.`, href: `${base}about/` },
];
---

<Layout
  title={`Page Not Found - ${BRAND_NAME}`}
  description={`This page could not be found. Use ${BRAND_NAME} links to continue exploring challenges, guides, and community resources.`}
  path="/404/"
  noindex
>
  <main id="main-content" tabindex="-1" class="flex min-h-[80vh] items-center px-6 md:px-16 py-20">
    <div class="mx-auto max-w-6xl w-full">
      <div class="mb-12">
        <SectionLabel>404</SectionLabel>
        <h1 class="text-4xl font-bold text-foreground mb-3">Page Not Found</h1>
        <p class="text-muted-foreground mb-2 leading-relaxed">This is not the page you were looking for.</p>
        <p class="text-muted-foreground leading-relaxed">Your search continues. We suggest starting here.</p>
      </div>

      <nav aria-label="Helpful links">
        <ul class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-left">
          {links.map((link) => (
            <li>
              <a
                href={link.href}
                class="flex flex-col gap-2 rounded-xl bg-primary p-7 h-full hover:bg-primary/90 transition-colors focus-ring"
              >
                <span class="text-base font-semibold text-primary-foreground">{link.label}</span>
                <span class="text-sm text-background/90 leading-relaxed">{link.desc}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </main>
</Layout>
