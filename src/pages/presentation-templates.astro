---
import Layout from "@/layouts/Layout.astro";
import IconGlobe from '~icons/lucide/globe';
import IconExternalLink from '~icons/lucide/external-link';
import IconDownload from '~icons/lucide/download';
import IconPresentation from '~icons/lucide/presentation';
import { BRAND_NAME } from "@/lib/site";

const base = import.meta.env.BASE_URL;

const SLIDEV_LAYOUTS: readonly string[] = [
  "Title slide with co-brand area",
  "Agenda table",
  "Bullet rows",
  "Two-column split",
  "Cards grid",
  "Speaker cards",
  "Bullet rows with tech tags",
  "Asymmetric split with image",
  "Two-column cards",
  "Contribute cards",
  "Board members",
  "Final / join slide",
];

const SLIDEV_STEPS: readonly { readonly step: number; readonly text: string }[] = [
  { step: 1, text: "Download and unzip the template. Rename the folder to your talk name (e.g. my-talk)." },
  { step: 2, text: "Install Node 26 and pnpm if not already installed. Run pnpm install inside the folder, then pnpm approve-builds (one-time)." },
  { step: 3, text: "Edit deck-template.md — each slide is a Markdown section separated by ---. Replace placeholder text, delete layouts you don't need." },
  { step: 4, text: "Run pnpm dev to preview in your browser at http://localhost:3030. Changes hot-reload." },
  { step: 5, text: "Run VSCODE_CWD= pnpm build to generate static HTML output. Commit the built output to public/decks/your-talk/ and push." },
];

const PPTX_INCLUDES: readonly string[] = [
  `Title slide with ${BRAND_NAME} branding`,
  "Section and content slide layouts",
  `${BRAND_NAME} color palette and typography`,
  "Speaker notes placeholder",
];
---

<Layout
  title={`Presentation Templates - ${BRAND_NAME}`}
  description={`Download slide templates for ${BRAND_NAME} events. Available as a Slidev (Markdown) template or an editable PowerPoint file.`}
  path="/presentation-templates/"
  noindex
>
  <main id="main-content" tabindex="-1" class="px-6 md:px-16 pt-28 pb-20">
    <div class="mx-auto max-w-4xl">
      <h1 class="font-heading text-3xl font-bold text-foreground mb-3">
        Presentation Templates
      </h1>
      <p class="text-muted-foreground mb-12 max-w-2xl">
        Slide templates for {BRAND_NAME} events and talks. Choose the format that fits your workflow.
      </p>

      <section aria-labelledby="slidev-heading">
        <div class="rounded-xl border border-surface-border bg-card p-6 flex flex-col gap-5">
          <div class="flex items-start gap-3">
            <span class="text-primary mt-0.5"><IconGlobe width={24} height={24} aria-hidden="true" /></span>
            <div>
              <h2 id="slidev-heading" class="font-heading text-lg font-bold text-foreground">
                Slidev Template
              </h2>
              <span class="text-xs text-muted-foreground">ZIP archive · Node 26 + pnpm required</span>
            </div>
          </div>

          <p class="text-sm text-muted-foreground leading-relaxed">
            Author slides in Markdown, preview with hot-reload, and build to self-contained static HTML.
            Fonts and assets are bundled at build time. Preview the live template on offon.dev before downloading.
          </p>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <div>
              <h3 class="text-sm font-semibold text-foreground mb-3">Included Slide Layouts</h3>
              <ul class="space-y-1.5" role="list">
                {SLIDEV_LAYOUTS.map((slide) => (
                  <li class="text-xs text-muted-foreground flex gap-2">
                    <span class="text-primary shrink-0 mt-px" aria-hidden="true">–</span>
                    <span>{slide}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div>
              <h3 class="text-sm font-semibold text-foreground mb-3">How to Create a New Deck</h3>
              <ul class="space-y-3" role="list">
                {SLIDEV_STEPS.map(({ step, text }) => (
                  <li class="flex gap-3 text-xs text-muted-foreground">
                    <span class="text-primary font-semibold shrink-0 w-4" aria-hidden="true">{step}.</span>
                    <span>{text}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <div class="flex flex-wrap gap-3 mt-auto justify-end">
            <a
              href={`${base}decks/template/`}
              target="_blank"
              rel="noopener noreferrer"
              aria-describedby="new-tab-hint"
              class="btn-ghost inline-flex items-center gap-2"
            >
              Preview the Template
              <IconExternalLink width={14} height={14} aria-hidden="true" />
            </a>
            <a
              href={`${base}downloads/offon-slidev-template.zip`}
              download="offon-slidev-template.zip"
              class="btn-primary inline-flex items-center gap-2"
            >
              <IconDownload width={16} height={16} aria-hidden="true" />
              Download Slidev ZIP
            </a>
          </div>
        </div>
      </section>

      <section aria-labelledby="pptx-heading" class="mt-6">
        <div class="rounded-xl border border-surface-border bg-card p-6 flex flex-col gap-5">
          <div class="flex items-start gap-3">
            <span class="text-primary mt-0.5"><IconPresentation width={24} height={24} aria-hidden="true" /></span>
            <div>
              <h2 id="pptx-heading" class="font-heading text-lg font-bold text-foreground">
                PowerPoint Template
              </h2>
              <span class="text-xs text-muted-foreground">PPTX file</span>
            </div>
          </div>

          <p class="text-sm text-muted-foreground leading-relaxed">
            An editable PowerPoint file with {BRAND_NAME} branding applied. Open in PowerPoint or Keynote and edit slides directly.
          </p>

          <ul class="space-y-1" role="list">
            {PPTX_INCLUDES.map((item) => (
              <li class="text-xs text-muted-foreground flex gap-2">
                <span class="text-primary shrink-0 mt-px" aria-hidden="true">–</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>

          <div class="flex mt-auto justify-end">
            <a
              href={`${base}downloads/offon-deck-template.pptx`}
              download="offon-deck-template.pptx"
              class="btn-primary inline-flex items-center gap-2"
            >
              <IconDownload width={16} height={16} aria-hidden="true" />
              Download PPTX
            </a>
          </div>
        </div>
      </section>
    </div>
  </main>
</Layout>
