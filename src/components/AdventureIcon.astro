---
import { LUCIDE_ICONS } from "@/lib/lucide-icons";

// Maps the stored icon name (Lucide PascalCase) to the kebab-case key in LUCIDE_ICONS.
const PASCAL_TO_KEBAB: Record<string, string> = {
  Building2: "building-2",
  Compass: "compass",
  Cloud: "cloud",
  FlaskConical: "flask-conical",
  Satellite: "satellite",
  Scale: "scale",
  Telescope: "telescope",
};

interface Props {
  icon?: string;
  size?: number;
  class?: string;
}
const { icon, size = 16, class: className } = Astro.props;
const kebab = icon ? PASCAL_TO_KEBAB[icon] : undefined;
const IconComponent = kebab ? LUCIDE_ICONS[kebab] : undefined;
---

{IconComponent && <IconComponent width={size} height={size} aria-hidden="true" class={className} />}
