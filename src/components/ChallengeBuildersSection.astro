---
import { getCollection } from "astro:content";
import PersonNameLink from "@/components/PersonNameLink.astro";
import InlineProse from "@/components/InlineProse.astro";
import { buildContributorIndex, type CreditAdventure } from "@/lib/adventure-credit";

const base = import.meta.env.BASE_URL;
const hasAside = Astro.slots.has("aside");

const adventures = await getCollection("adventures");
const contributors = buildContributorIndex(adventures.map((a) => a.data as CreditAdventure));
---

{contributors.length > 0 && (
  <section id="challenge-contributors" aria-labelledby="challenge-contributors-heading" class="px-6 md:px-16 pb-16">
    <div class="mx-auto max-w-6xl">
      <div class={hasAside ? "grid grid-cols-1 lg:grid-cols-[1fr_300px] gap-12" : ""}>
        <div>
          <h2 id="challenge-contributors-heading" class="text-2xl font-bold text-foreground">Challenge Contributors</h2>
          <p class="mt-4 max-w-3xl text-muted-foreground leading-relaxed">
            Adventures don't build themselves. A heartfelt thank you to everyone who has put in the time and care to create them.
          </p>
          <div class="mt-8 grid gap-4 sm:grid-cols-2">
            {contributors.map((contributor) => (
              <div class="card-glow rounded-xl border border-border bg-[hsl(var(--surface))] p-6">
                <PersonNameLink name={contributor.name} url={contributor.url} />
                {contributor.aboutHtml && (
                  <InlineProse html={contributor.aboutHtml} class="mt-1.5 text-sm text-muted-foreground leading-relaxed" />
                )}
                <p class="mt-6 mb-3 text-xs font-medium text-muted-foreground uppercase tracking-wider">adventures contributed to</p>
                <ul role="list" class="space-y-2.5">
                  {contributor.contributions.map(({ slug, title }) => (
                    <li class="text-sm">
                      <a href={`${base}adventures/${slug}/`} class="docs-ext-link">{title}</a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
        {hasAside && (
          <div class="hidden lg:block">
            <div class="sticky top-24">
              <slot name="aside" />
            </div>
          </div>
        )}
      </div>
    </div>
  </section>
)}
