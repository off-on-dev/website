---
import IconSun from "~icons/lucide/sun";
import IconMoon from "~icons/lucide/moon";

// Light/dark switch. Static markup plus one delegated listener, no framework.
//
// Both the icon and the accessible name are chosen by CSS from the `.dark` class
// on <html>, which the inline script in Layout.astro sets before first paint.
// That means the control is already correct for a returning light-mode visitor
// in the very first frame, with no JS involved, and it is why no state is
// exchanged between the two instances: they both read the same class.
//
// The name comes from the sr-only spans rather than aria-label, because an
// attribute cannot be swapped by CSS.

interface Props {
  variant?: "desktop" | "mobile";
}
const { variant = "mobile" } = Astro.props;
---

<button
  type="button"
  data-theme-toggle
  class:list={[
    "flex h-11 w-11 items-center justify-center rounded-md border border-border bg-[hsl(var(--surface))] text-foreground/70 hover:text-foreground transition-all focus-ring",
    variant === "desktop" && "hover:border-primary/30",
  ]}
>
  <IconSun width={18} height={18} aria-hidden="true" class="hidden dark:block" />
  <IconMoon width={18} height={18} aria-hidden="true" class="block dark:hidden" />
  <span class="sr-only hidden dark:inline">Switch to light mode</span>
  <span class="sr-only inline dark:hidden">Switch to dark mode</span>
</button>

<script>
  // Delay before writing the announcement, then before clearing it. A live
  // region that already holds text is not re-announced when the text is
  // identical, so it is cleared, set, then cleared again.
  const ANNOUNCE_DELAY_MS = 50;
  const ANNOUNCE_CLEAR_MS = 1600;

  let announceSet: ReturnType<typeof setTimeout> | undefined;
  let announceClear: ReturnType<typeof setTimeout> | undefined;

  function announce(theme: "dark" | "light"): void {
    const status = document.getElementById("theme-status");
    if (!status) return;
    clearTimeout(announceSet);
    clearTimeout(announceClear);
    status.textContent = "";
    announceSet = setTimeout(() => {
      status.textContent =
        theme === "dark" ? "Theme switched to dark mode" : "Theme switched to light mode";
    }, ANNOUNCE_DELAY_MS);
    announceClear = setTimeout(() => {
      status.textContent = "";
    }, ANNOUNCE_CLEAR_MS);
  }

  // Delegated on document, so it survives View Transitions without rebinding and
  // covers every toggle instance at once. The module runs once per page load.
  document.addEventListener("click", (event) => {
    const target = event.target as Element | null;
    if (!target?.closest?.("[data-theme-toggle]")) return;

    const root = document.documentElement;
    const next = root.classList.contains("light") ? "dark" : "light";

    root.classList.toggle("light", next === "light");
    root.classList.toggle("dark", next === "dark");

    try {
      localStorage.setItem("theme", next);
    } catch {
      /* storage unavailable; the choice just will not survive a reload */
    }

    announce(next);
  });
</script>
